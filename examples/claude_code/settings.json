{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "uv run --project /path/to/hallucination-firewall hfw-hook capture" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "uv run --project /path/to/hallucination-firewall hfw-hook stop" }]
      }
    ]
  },
  "permissions": {
    "allow": ["mcp__hfw"]
  }
}
